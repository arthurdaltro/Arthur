# Credentials — verified in Phase L. Never commit .env.
ADAPTER_MODE=mock            # mock | live

# Google Sheets (service account JSON, base64) + target sheet
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEET_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM=                 # e.g. "Transformation Center <start@yourdomain.com>"

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_IDS=       # JSON map service -> eventTypeId

# Stripe (test mode: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
