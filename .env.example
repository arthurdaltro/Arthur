# Credentials — verified in Phase L. Never commit .env.
ADAPTER_MODE=mock            # mock | live

# SimplePractice booking widget (primary handoff)
SIMPLEPRACTICE_BOOKING_URL=

# Protect /api/intakes (dashboard) when deployed
DASHBOARD_TOKEN=
TEAM_NOTIFY_EMAIL=
PORT=3000

# Google Sheets (service account JSON, base64) + target sheet
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEET_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM=                 # e.g. "Transformation Center <start@yourdomain.com>"

# Alternative handoff: Cal.com (payments via Cal.com's Stripe app — no key needed here)
CALCOM_BOOKING_URL=
